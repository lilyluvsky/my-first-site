function toggleDarkMode() {
  document.body.classList.toggle("dark");

  if (document.body.classList.contains("dark")) {
    localStorage.setItem("darkMode", "enabled");
  } else {
    localStorage.setItem("darkMode", "disabled");
  }
}

function loadDarkMode() {
  if (localStorage.getItem("darkMode") === "enabled") {
    document.body.classList.add("dark");
  }
}

function filterProjects() {
  const searchInput = document.getElementById("projectSearch");
  const filterSelect = document.getElementById("projectFilter");
  const projectCount = document.getElementById("projectCount");
  const cards = document.querySelectorAll(".project-card");

  if (!searchInput || !filterSelect || !projectCount || cards.length === 0) {
    return;
  }

  const searchText = searchInput.value.toLowerCase();
  const selectedFilter = filterSelect.value.toLowerCase();

  let visibleCount = 0;

  cards.forEach(card => {
    const text = card.innerText.toLowerCase();
    const tags = card.dataset.tags ? card.dataset.tags.toLowerCase() : "";

    const matchesSearch = text.includes(searchText) || tags.includes(searchText);
    const matchesFilter = selectedFilter === "all" || tags.includes(selectedFilter);

    if (matchesSearch && matchesFilter) {
      card.style.display = "block";
      visibleCount += 1;
    } else {
      card.style.display = "none";
    }
  });

  projectCount.textContent = `${visibleCount} project(s) shown`;
}

function resetProjectFilters() {
  const searchInput = document.getElementById("projectSearch");
  const filterSelect = document.getElementById("projectFilter");

  if (searchInput) {
    searchInput.value = "";
  }

  if (filterSelect) {
    filterSelect.value = "all";
  }

  filterProjects();
}

function toggleDetails(id) {
  const element = document.getElementById(id);

  if (!element) {
    return;
  }

  element.classList.toggle("show");
}

function copyCommand(command) {
  navigator.clipboard.writeText(command).then(() => {
    alert("Command copied.");
  }).catch(() => {
    alert("Could not copy command.");
  });
}

function scrollToTop() {
  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

function handleBackToTopButton() {
  const button = document.getElementById("backToTop");

  if (!button) {
    return;
  }

  if (window.scrollY > 300) {
    button.style.display = "block";
  } else {
    button.style.display = "none";
  }
}

document.addEventListener("DOMContentLoaded", () => {
  loadDarkMode();
  filterProjects();
  handleBackToTopButton();
});

window.addEventListener("scroll", handleBackToTopButton);
